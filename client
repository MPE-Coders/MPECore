#!/usr/bin/env bash
set -euo pipefail
umask 077
ROOT="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
command -v node >/dev/null || { echo 'Node.js >=24 is required.' >&2; exit 2; }
# Help, profile listing, and RakNet ping do not need downloaded dependencies.
for arg in "$@"; do
  case "$arg" in --help|--list-protocols|--ping-only) exec node "$ROOT/test-client/main.cjs" "$@";; esac
done
if [[ ! -d "$ROOT/node_modules/bedrock-protocol" ]]; then
  echo 'Install client dependencies first: ./tools/node-install.sh' >&2
  exit 2
fi
exec node "$ROOT/test-client/main.cjs" "$@"
